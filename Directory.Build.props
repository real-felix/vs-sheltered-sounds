<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == ''">$(VINTAGE_STORY)</VintageStoryPath>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">/Applications/Vintage Story.app</VintageStoryPath>
  </PropertyGroup>
  <Target Name="CheckGamePath" BeforeTargets="ResolveReferences" Condition="!Exists('$(VintageStoryPath)/VintagestoryAPI.dll') or !Exists('$(VintageStoryPath)/Mods/VSEssentials.dll') or !Exists('$(VintageStoryPath)/Lib/0Harmony.dll')">
    <Error Text="Set VINTAGE_STORY or -p:VintageStoryPath to your Vintage Story 1.22.0 or later installation (including Mods and Lib)." />
  </Target>
</Project>
